{
  "name": "acessocomercial-public",
  "private": true,
  "description": "Acesso Comercial — SDK and starter templates for building storefronts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:sdk": "npm run build -w packages/storefront-sdk",
    "build:tools": "npm run build -w packages/storefront-tools",
    "templates": "npx http-server temp -p 8765 -c-1"
  },
  "engines": {
    "node": ">=18"
  }
}
