{
  "name": "@acessocomercial/storefront-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Acesso Comercial Storefront API — browse products, manage cart, checkout, and handle authentication.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "getschema": "npx tsx scripts/getSchema.ts",
    "update": "npm run getschema"
  },
  "keywords": [
    "storefront",
    "ecommerce",
    "graphql",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "graphql": "^16.14.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
