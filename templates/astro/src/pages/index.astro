---
import BaseLayout from '../layouts/BaseLayout.astro';
import { storefront } from '../lib/storefront';

const products = await storefront.products.list({ first: 40 });
const storeInfo = await storefront.store.get();
const storeName = storeInfo?.name || 'Loja';
const productCount = products.edges?.length || 0;

const formatPrice = (cents: number) =>
  (cents / 100).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<BaseLayout title={storeName}>
  <Fragment slot="head">
    <style>
      .hero{background:var(--color-bg-subtle);border-bottom:1px solid var(--color-border);padding:64px 24px 72px;text-align:center}
      .hero-inner{max-width:640px;margin:0 auto}
      .hero-eyebrow{display:inline-block;padding:6px 16px;background:var(--color-accent);color:#fff;border-radius:var(--radius-full);font-size:.75rem;font-weight:600;letter-spacing:.03em;text-transform:uppercase;margin-bottom:20px}
      .hero-title{font-size:clamp(2rem,5vw,3rem);font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-bottom:12px}
      .hero-subtitle{font-size:1.1rem;color:var(--color-text-secondary);margin-bottom:28px}
      .hero-cta{display:inline-flex;align-items:center;padding:14px 32px;background:var(--color-accent);color:#fff;border-radius:var(--radius-full);font-size:.9rem;font-weight:600;transition:all var(--transition)}
      .hero-cta:hover{background:var(--color-accent-hover);transform:translateY(-1px);box-shadow:var(--shadow-md)}

      .products-section{max-width:var(--container);margin:0 auto;padding:48px 24px 80px}
      .section-header{display:flex;align-items:baseline;gap:12px;margin-bottom:32px}
      .section-header h2{font-size:1.5rem;font-weight:700;letter-spacing:-.02em}
      .product-count{font-size:.85rem;color:var(--color-text-muted)}

      .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px}
      .product-card{position:relative;border-radius:var(--radius-md);overflow:hidden;background:var(--color-bg);border:1px solid var(--color-border);transition:all var(--transition)}
      .product-card:hover{border-color:var(--color-border-strong);box-shadow:var(--shadow-md);transform:translateY(-3px)}
      .product-card-image{aspect-ratio:3/4;overflow:hidden;background:var(--color-bg-muted)}
      .product-card-image img{width:100%;height:100%;object-fit:cover;transition:transform .4s cubic-bezier(.4,0,.2,1)}
      .product-card:hover .product-card-image img{transform:scale(1.05)}
      .product-card-info{padding:16px}
      .product-card-title{font-size:.9rem;font-weight:600;margin-bottom:6px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
      .product-card-price{font-size:1rem;font-weight:700;letter-spacing:-.01em}

      @media(max-width:640px){.hero{padding:48px 16px 56px}.products-section{padding:32px 16px 60px}.product-grid{grid-template-columns:repeat(2,1fr);gap:12px}.product-card-info{padding:12px}.product-card-title{font-size:.82rem}.product-card-price{font-size:.88rem}}
    </style>
  </Fragment>

  <section class="hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">Nova Coleção</span>
      <h1 class="hero-title">Descubra nossos produtos</h1>
      <p class="hero-subtitle">Qualidade, estilo e os melhores preços para você.</p>
      <a href="#products-section" class="hero-cta">Ver Produtos</a>
    </div>
  </section>

  <section class="products-section" id="products-section">
    <div class="section-header">
      <h2>Produtos</h2>
      <span class="product-count">{productCount} produtos</span>
    </div>
    <div class="product-grid">
      {products.edges.map(({ node: product }) => (
        <div class="product-card" data-ac-product-id={product.id} data-ac-price={String(product.price)}>
          <div class="product-card-image">
            <img
              src={product.images?.[0]?.url || 'https://placehold.co/400x533/f1f3f5/adb5bd?text=Sem+imagem'}
              alt={product.title}
              loading="lazy"
            />
          </div>
          <div class="product-card-info">
            <div class="product-card-title">{product.title}</div>
            <div class="product-card-price">R$ {formatPrice(product.price)}</div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
