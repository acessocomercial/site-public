---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <style>
      .info-page{max-width:1280px;margin:0 auto;padding:40px 24px 80px}
      .info-page-inner{max-width:720px;margin:0 auto}
      .info-page-back{display:inline-flex;align-items:center;gap:6px;font-size:.88rem;font-weight:500;color:var(--color-text-secondary);margin-bottom:24px;transition:color var(--transition)}
      .info-page-back:hover{color:var(--color-text)}
      .info-page-title{font-size:1.8rem;font-weight:800;letter-spacing:-.03em;margin-bottom:32px;color:var(--color-text)}
      .info-page-content{line-height:1.8;color:var(--color-text-secondary)}
      .info-page-content h3{font-size:1.05rem;font-weight:700;color:var(--color-text);margin:28px 0 12px}
      .info-page-content p{margin-bottom:16px}
      .info-page-content ul,.info-page-content ol{margin:0 0 16px 24px}
      .info-page-content li{margin-bottom:8px}
      .info-page-content .faq-item{padding:20px 0;border-bottom:1px solid var(--color-border)}
      .info-page-content .faq-item:last-child{border-bottom:none}
      .info-page-content .faq-item h3{margin-top:0}
    </style>
  </Fragment>

  <div class="info-page">
    <div class="info-page-inner">
      <a href="/" class="info-page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Voltar
      </a>
      <h1 class="info-page-title">{title}</h1>
      <div class="info-page-content">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
